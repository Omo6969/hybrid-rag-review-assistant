# Copy this file to .env and replace the placeholder values.
# Do not commit your real .env file.
# Required for the LLM to access the GROQ API and for any environment-specific configuration.
# See https://console.groq.com/playground for the model IDs your account can
# currently use -- Groq periodically retires older models (e.g.
# llama-3.3-70b-versatile), so check there rather than assuming a fixed name.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_preferred_groq_model_here

# App environment label - development, staging, or production
APP_ENV=development