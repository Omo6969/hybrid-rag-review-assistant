*ipynb_checkpoints*
environment.pinned.yml
/.venv/
/.env
__pycache__/
*.pyc
*.csv

# Keep the folders, ignore their contents
data/raw/*
data/processed/*

# But keep placeholder files so the folders exist in Git
!data/raw/.gitkeep
!data/processed/.gitkeep

# indexes / artifacts
*.pkl
*.pickle
*.index
*.faiss
*.npy

# Small prebuilt sample retrieval artifacts are committed on purpose so that
# Posit Connect Cloud (and anyone else without the full 701k-row dataset) can
# deploy/run the app out of the box. See deploy/README.md.
!deploy/sample_data/**/*.pkl
!deploy/sample_data/**/*.pickle
!deploy/sample_data/**/*.index
!deploy/sample_data/**/*.faiss
!deploy/sample_data/**/*.npy

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*PKG-INFO*
dependency_links.txt
SOURCES.txt
top_level.txt

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/